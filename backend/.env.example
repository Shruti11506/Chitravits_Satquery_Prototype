# Backend configuration. Copy to backend/.env (gitignored -- never commit it)
# or run `npm run setup` from the repo root, which does that for you.
#
# Everyone on the team points at the SAME Supabase project, so everyone sees
# the same conversations, uploads and history. Get the values from the
# Supabase dashboard (Project Settings -> API) or from the project owner,
# shared privately -- never via GitHub.

# Supabase project URL, e.g. https://xxxxx.supabase.co
SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL

# The SECRET key: "secret" (sb_secret_...) or legacy "service_role" JWT.
# Backend only -- NEVER put it in the frontend or in a VITE_* variable.
# Not the publishable/anon key: with that one Row Level Security hides every
# row, so the backend refuses it (503 SUPABASE_NOT_CONFIGURED) rather than
# showing an empty history.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# Public/publishable key -- optional; loaded but not used by the backend.
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

APP_NAME=SatQuery Backend
APP_VERSION=0.1.0
# development = also accept a local frontend on any localhost port (Vite moves
# to 5174, 5175, ... when 5173 is busy). Use production only for a deployment.
APP_ENV=development
# Calendar days for the profile heatmap/streaks (IANA name).
APP_TIMEZONE=Asia/Kolkata

# Comma-separated list of origins allowed to call this API (in production the
# deployed frontend's URL; in development any localhost port is also allowed).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Must match an existing Supabase Storage bucket -- the backend never creates one.
SUPABASE_STORAGE_BUCKET=Satquery
# Supabase's platform default is 50MB unless your project raises it
# (Dashboard -> Storage -> Settings) or the bucket sets its own limit.
MAX_UPLOAD_SIZE_MB=50

# Input Validation resource limits (app/validation/limits.py). File size is
# governed by MAX_UPLOAD_SIZE_MB above.
VALIDATION_MAX_IMAGE_WIDTH=20000
VALIDATION_MAX_IMAGE_HEIGHT=20000
VALIDATION_MAX_BANDS=50
VALIDATION_MAX_PIXELS=400000000
# The highest `required_images` any workflow in WORKFLOW_REGISTRY declares
# (image pairs) -- raise this only if a workflow needing more is added.
VALIDATION_MAX_INPUT_IMAGES=2
